# Reviewed code and the approved public knowledge snapshot are allowed explicitly.
# Credentials, personal working files and other datasets remain excluded.
*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.python-version
!/LICENSE
!/README.md
!/SECURITY.md
!/knowledge_core/
!/knowledge_core/*.py
!/knowledge_core/schema.sql
!/knowledge_core/README.md
!/tests/
!/tests/test_knowledge_core_*.py
!/.github/
!/.github/workflows/
!/.github/workflows/ci.yml
!/knowledge/
!/knowledge/README.md
!/knowledge/manifest.json
!/knowledge/packed-manifest.json
!/knowledge/knowledge.sqlite.gz
!/knowledge/blobs/
!/knowledge/blobs/*/
!/knowledge/blobs/*/*
!/knowledge/catalog/
!/knowledge/catalog/**
