te_ids":[],"warning_candidate_ids":["RGC-001-017","RGC-002-013","RGC-002-021","RGC-006-051","RGC-015-035","RGC-016-037","RGC-017-028","RGC-017-040","RGC-023-004"],"assignment_method_counts":{"keyword_score":193,"rule_specific_default":62},"route_terms":["стоп","инвалидация","люфт"],"parent_draft_rule_points_for_review":[{"candidate_id":"MM-046-010","point":"Для заранее подготовленного пробоя ниже уровня предпочтителен стоп-лимит: первая цена активирует ордер, вторая ограничивает максимальную цену покупки. Стоп-маркет проще, но может дать сильное проскальзывание и испортить стоп/тейк."},{"candidate_id":"MM-046-018","point":"Предпробойная база подходит для входа с открытия только если стоп за базу не слишком большой; в Long 1 попадают две повторяющиеся модели: поступательное движение с базой у хай и параболическое закругление после падения с закрытием на хай или выше уровня."},{"candidate_id":"MM-047-010","point":"Стоп должен стоять там, где ломается дневная картинка, обычно ниже дневного уровня, а не над случайным локальным уровнем. Для разворота от хвоста можно использовать локальный уровень, хотя он слабее дневного, потому что дневной контекст дает направление."},{"candidate_id":"MM-047-028","point":"Глобальная линия по двум точкам может подсказать траекторию и зону выхода, но лектор прямо запрещает шортить только от такой линии: без технического места для стопа входа нет."},{"candidate_id":"MM-048-017","point":"Маркет дает гарантированное исполнение, но с проскальзыванием; стоп-маркет заранее превращается в маркет и тоже скользит; обычный лимит нельзя ставить в пробой, потому что он исполнится до пробоя. Для пробоя лучше стоп-лимит с двумя ценами: цена активации и максимальная максимальная лимитная цена."},{"candidate_id":"MM-048-020","point":"Вход через лимит: D1-БСУ формирует уровень, на M5 нужны БПУ1 и БПУ2 — два последовательных удара в одну точку. Лимит ставится чуть выше уровня, люфт равен 20% расчетного стопа, а расчетный стоп ориентировочно 10% ATR. БПУ до