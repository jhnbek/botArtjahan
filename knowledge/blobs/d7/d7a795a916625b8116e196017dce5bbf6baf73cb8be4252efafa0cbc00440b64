65-005","MM-065-007","MM-066-003","MM-068-006","MM-068-007","MM-068-015","MM-019-005","MM-019-006","MM-024-040","MM-027-028","MM-044-004","MM-044-005","MM-044-009","MM-045-020","MM-050-004","MM-050-007"],"source_candidate_count":139,"accepted_misc_candidate_ids":["MM-019-005","MM-019-006","MM-024-040","MM-027-028","MM-044-004","MM-044-005","MM-044-009","MM-045-020","MM-050-004","MM-050-007"],"conditional_candidate_ids":[],"warning_candidate_ids":[],"draft_rule_points_for_review":[{"candidate_id":"MM-046-008","point":"Сильный шорт-кандидат: ближний ретест с отлипанием, закрытие на лои, хороший запас хода и контекст, где покупатели после отскока вынуждены выходить. Но заранее узнать, будет ли вместо продолжения ложный пробой, невозможно."},{"candidate_id":"MM-048-022","point":"При распиле уровня нужно ждать либо превращения в лимит, либо отлипания от уровня и возврата. Для лонговой дневки сильный паттерн: распил, отлипание вниз не глубже 30% ATR, возврат вверх; импульс должен идти за счет стопов шортистов, а стоп ставится за хвост ложного пробоя или локальную структуру."},{"candidate_id":"MM-049-019","point":"Торговля ложного пробоя в теории — это первый возврат, но лектор не любит входить сразу на первый возврат: будет много стопов. Более спокойный вход — закрытие бара под/над уровнем, борьба вокруг уровня, лимитка и стоп за хвостами. Шорт можно воспринимать как перевернутый лонг, чтобы легче увидеть структуру."},{"candidate_id":"MM-049-021","point":"До реальной торговли нужно переписать конспект, выбрать, что именно хочется торговать, и параллельно собирать сценарии. Лектор предупреждает, что с высокой вероятностью тот, кто перепрыгнет этот этап и сразу начнет торговать, потеряет деньги и тяжелее задержится в трейдинге."},{"candidate_id":"MM-052-012","point":"Финальный вывод: один бар ничего не значит. Нужно учитывать несколько баров, S&P, откуда пришло движение, что произошло вчера и позавчера, как закрылись и где открылись. После сильного ложного пробоя опасно сразу ловить новый ложный пробой в обратную сторону, потому что цена может продолжать реакцию на исходный ложный пробой. Такой же Starbucks-график вряд ли повторится один в один, но важен ход мысли."},{"candidate_id":"MM-039-015","point":"Если график отобран в шорт по старшему контексту, нельзя переворачиваться в лонг только потому, что на M5 появилась хорошая лонговая картинка. Если шортовая картина не сформировалась, сделка просто пропускается."},{"candidate_id":"MM-048-004","point":"После ухода хороших ситуаций нельзя ковырять остатки графиков. Чем меньше дневная волатильность у уровня, тем легче получить чистую M5-ТВХ и короткий стоп; большие дневные бары дают выбивания и повторные стопы."},{"candidate_id":"MM-048-012","point":"На крипте идеальная предпробойная база встречается реже; чаще будет пробой, распил и закрепление. Главные фильтры сложных входов — маленькая волатильность относительно истории слева и факт, что уровень перестали пилить; H1-закрытие помогает, но после паранормального часа лучше дождаться следующего часа."},{"candidate_id":"MM-048-027","point":"Уровень пилят, когда крупный игрок еще не набрал позицию и собирает объем у ранних испуганных участников. Дневной ложный пробой или маленький бар с повышенным объемом может дать энергию следующего дня; стопы шортистов над уровнем питают движение вверх, а когда все начинают верить в рост, появляется энергия для падения."},{"candidate_id":"MM-049-014","point":"Прямо перед закрытием дневного бара входить нежелательно: закрытие меняет волатильность и структуру. Если до закрытия осталось мало времени, лучше дождаться открытия новой дневки и уже там искать ложный пробой."},{"candidate_id":"MM-053-006","point":"Если домашка и сделки нормально работают без скользящих средних, добавлять их не нужно: новые слои могут запутать. SMA можно использовать только как моральное подтверждение или как сканер внимания, например заметить, что цена ниже 20-дневной средней и затем уже искать реальные предпосылки и уровень."},{"candidate_id":"MM-036-018","point":"Плечо становится реально опасным, когда трейдер берет максимальный объем на весь баланс без понятного стопа; тогда убыток считается по полной сумме сделки, и при достижении баланса происходит ликвидация."},{"candidate_id":"MM-037-006","point":"Если взять больше рассчитанного количества, убыток по стопу будет больше заданного риска; если входить позднее и дальше от уровня, стоп увеличивается, количество падает, а цель 3 к 1 оказывается дальше."},{"candidate_id":"MM-041-021","point":"Некрасивые графики с множеством хвостов, паранормальных баров и близких уровней лучше пропускать: поведение распиленного D1-уровня повторится на M5 и усложнит вход."},{"candidate_id":"MM-041-026","point":"Учиться надо на начале движения, а не догонять уже реализованный импульс: поздний вход после большого падения ловит фиксацию, закрытие шортов и случайные задерги."},{"candidate_id":"MM-045-013","point":"При непонятном S&P недостаточно, чтобы акция просто закрылась лучше индекса: нужны графики, способные двигаться собственной силой, иначе они будут стоять или падать вместе с рынком."},{"candidate_id":"MM-046-026","point":"Если дневной уровень выглядит распиленным, H1 может показать, что уровень реально отрабатывает: ложные пробои и подтверждения на H1 позволяют оставить идею, несмотря на шум D1."},{"candidate_id":"MM-056-009","point":"Экстремум, куда цена смогла дойти и откуда отскочила, можно ждать как уровень для ложного пробоя или ближнего ретеста. Но если уровень уже пилится, его нельзя торговать сразу: нужно дождаться, чтобы один из баров перестал пилить линию, либо чтобы цена отошла, вернулась и дала новую структуру для пробоя."}],"conditions_for_review":[{"candidate_id":"MM-046-008","point":"Сильный шорт-кандидат: ближний ретест с отлипанием, закрытие на лои, хороший запас хода и контекст, где покупатели после отскока вынуждены выходить. Но заранее узнать, будет ли вместо продолжения ложный пробой, невозможно."},{"candidate_id":"MM-048-022","poi