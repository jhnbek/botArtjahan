{"unit_id": "lec_001_8a48d90c_seg_0112", "artifact_type": "multimodal_evidence_unit", "course_position": 1, "lecture_title": "ведение", "lecture_id": "lec_001_8a48d90c", "segment_index": 112, "start_sec": 3046.01, "end_sec": 3066.52, "time": "00:50:46-00:51:07", "text": "Просто прийти, что-то там раз-два узнал, где-то там нажал, так не получится. Быстро можно заработать только случайно, а нам случайность не интересна, потому что те, кто зарабатывает случайно, на дистанции эти люди просто вылетают в трубу, они как бы уходят с трейдинга.", "frames": [{"time_sec": 3052.125, "time": "00:50:52", "path": "ведение/frames/frame_00066.jpg", "trigger": "max_gap", "scene_index": null, "linked_segment_index": 112, "ocr_text": "МГГ", "ocr_line_count": 1, "ocr_repair_version": "ocr_unicode_path_repair_v1"}], "frame_count": 1, "ocr_frame_count": 1, "ocr_chars": 3}
