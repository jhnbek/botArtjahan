{"unit_id": "lec_016_596d35da_seg_0094", "artifact_type": "multimodal_evidence_unit", "course_position": 16, "lecture_title": "урок 14", "lecture_id": "lec_016_596d35da", "segment_index": 94, "start_sec": 2941.52, "end_sec": 2968.62, "time": "00:49:02-00:49:29", "text": "по доллар 20 и вот этим ордером тут 30 центов это много это 20 процентов от цены это много большой шаг между каждым ордером а мы сейчас говорим про большую плотность большая плотность это например доллар 01 доллар доллар 011 например доллар 012 доллар 013", "frames": [], "frame_count": 0, "ocr_frame_count": 0, "ocr_chars": 0}
