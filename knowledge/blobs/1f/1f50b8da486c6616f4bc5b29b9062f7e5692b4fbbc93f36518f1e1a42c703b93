{"candidate_id":"MM-002-003","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":2,"lecture_title":"урок 01","topic":"energy","scenario":"accumulation","claim_type":"definition","tags":["exit","levels"],"primary_tag":"exit","statement":"Энергия накопления возникает, когда цена ходит внутри диапазона между верхней и нижней границей; это топливо для будущего выхода из диапазона в одну из сторон.","quote":"Один из видов энергии — это энергия накопления... цена ходит от одной границы до другой... должно быть топливо для этого движения.","interpretation":"Накопление не требует фиксированного числа касаний в этой лекции; важна идея диапазона и энергии внутри него.","confidence":0.9,"maturity":"observed_multimodal","source_time":"00:02:54-00:06:44","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_002_185f9241","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_002_urok_01/claims_multimodal.jsonl","source_units":["lec_002_185f9241_seg_0006","lec_002_185f9241_seg_0007","lec_002_185f9241_seg_0008","lec_002_185f9241_seg_0009","lec_002_185f9241_seg_0014","lec_002_185f9241_seg_0015"],"source_frames":[{"path":"урок 01/frames/frame_00006.jpg","time":"00:02:56"},{"path":"урок 01/frames/frame_00007.jpg","time":"00:04:09"},{"path":"урок 01/frames/frame_00009.jpg","time":"00:06:12"}],"source_unit_count":6,"source_frame_count":3,"quote_source_overlap":1.0},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
