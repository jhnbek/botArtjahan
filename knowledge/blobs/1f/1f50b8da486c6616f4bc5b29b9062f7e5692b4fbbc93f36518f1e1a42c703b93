{"candidate_id":"MM-026-005","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":26,"lecture_title":"урок 23","topic":"accumulative_approach_to_level","scenario":"breakout_premise","claim_type":"principle","tags":["breakout","levels","saw","trend_context"],"primary_tag":"breakout","statement":"Если поступательное движение с плотным выкупом скапливается перед уровнем, оно ведет к пробою: продавцы уже выставлены перед уровнем, и у самого уровня может остаться меньше встречных заявок.","quote":"если это движение скопилось... перед уровнем, то вот такое поступательное движение, это ведет к пробою","interpretation":"Поступательный подход к уровню должен повышать вероятность пробоя сильнее, чем одиночный импульсный рывок.","confidence":0.95,"maturity":"observed_multimodal","source_time":"00:05:13-00:07:11","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_026_f125c472","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_026_urok_23/claims_multimodal.jsonl","source_units":["lec_026_f125c472_seg_0010","lec_026_f125c472_seg_0011","lec_026_f125c472_seg_0012","lec_026_f125c472_seg_0013"],"source_frames":[{"path":"урок 23/frames/frame_00008.jpg","time":"00:05:28"}],"source_unit_count":4,"source_frame_count":1,"quote_source_overlap":1.0},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
