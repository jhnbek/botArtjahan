{"candidate_id":"MM-013-038","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":13,"lecture_title":"урок 12 ч 1","topic":"pullback_bar_level","scenario":"btc_pullback_level_rehigh_origin","claim_type":"example","tags":["levels","timeframes","trend_context"],"primary_tag":"levels","statement":"BTC-пример показывает нижнюю границу отката: после движения вверх, отката и продолжения цена от этой точки пошла пробивать ближайший максимум, поэтому точка становится сильным уровнем отката.","quote":"Отсюда пошло движение, которое пробило вот этот максимум... эта точка является сильным уровнем.","interpretation":"The origin of the re-high movement is the relevant pullback level, not necessarily the first reaction bar.","confidence":0.87,"maturity":"observed_multimodal","source_time":"01:08:31-01:10:52","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_013_fe508895","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_013_urok_12/claims_multimodal.jsonl","source_units":["lec_013_fe508895_seg_0125","lec_013_fe508895_seg_0126","lec_013_fe508895_seg_0127","lec_013_fe508895_seg_0128"],"source_frames":[{"path":"урок 12 ч 1/frames/frame_00086.jpg","time":"01:08:57"},{"path":"урок 12 ч 1/frames/frame_00088.jpg","time":"01:10:30"}],"source_unit_count":4,"source_frame_count":2,"quote_source_overlap":1.0},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
