{"candidate_id":"MM-010-004","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":10,"lecture_title":"урок 09","topic":"close","scenario":"close_beyond_level_context","claim_type":"principle","tags":["breakout","false_breakout","levels","trend_context"],"primary_tag":"breakout","statement":"Закрытие за уровнем само по себе является сильным сигналом продолжения, но его нужно читать через контекст подхода к пробою: одни подходы ведут к продолжению, другие к ложному пробою.","quote":"Закрытие ниже уровня - это очень сильный сигнал... Есть движения, которые происходили до пробоя, они ведут к развороту, а есть... к продолжению.","interpretation":"Close relative to level является важным, но не самодостаточным сигналом без prior approach features.","confidence":0.86,"maturity":"observed_multimodal","source_time":"00:03:40-00:05:15","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_010_de07310a","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_010_urok_09/claims_multimodal.jsonl","source_units":["lec_010_de07310a_seg_0007","lec_010_de07310a_seg_0008","lec_010_de07310a_seg_0009","lec_010_de07310a_seg_0010"],"source_frames":[{"path":"урок 09/frames/frame_00013.jpg","time":"00:03:26"}],"source_unit_count":4,"source_frame_count":1,"quote_source_overlap":0.938},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
