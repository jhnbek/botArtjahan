{"candidate_id":"MM-007-002","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":7,"lecture_title":"урок 06","topic":"accumulation","scenario":"channel_width_duration","claim_type":"principle","tags":["exit","levels"],"primary_tag":"exit","statement":"Ширина и длительность канала задают характер выхода: узкий и короткий канал чаще дает резкий непродолжительный импульс, а широкий и долгий канал чаще дает более продолжительный выход, иногда стандартными барами, иногда несколькими паранормальными барами.","quote":"Чем уже канал и чем он меньше по времени, тем резче будет выход и тем он непродолжительный... чем шире канал и чем дольше канал, более продолжительный будет выход.","interpretation":"Geometry/time of range should be tracked as an input to movement potential, not as decorative chart shape.","confidence":0.9,"maturity":"observed_multimodal","source_time":"00:00:57-00:09:09","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_007_a8120ad5","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_007_urok_06/claims_multimodal.jsonl","source_units":["lec_007_a8120ad5_seg_0002","lec_007_a8120ad5_seg_0004","lec_007_a8120ad5_seg_0006","lec_007_a8120ad5_seg_0008","lec_007_a8120ad5_seg_0011","lec_007_a8120ad5_seg_0012","lec_007_a8120ad5_seg_0016","lec_007_a8120ad5_seg_0019","lec_007_a8120ad5_seg_0020"],"source_frames":[{"path":"урок 06/frames/frame_00002.jpg","time":"00:01:00"},{"path":"урок 06/frames/frame_00007.jpg","time":"00:04:11"},{"path":"урок 06/frames/frame_00014.jpg","time":"00:06:52"}],"source_unit_count":9,"source_frame_count":3,"quote_source_overlap":1.0},"support_annotation_count":2,"support_gap_ids":["LEGACY-GAP-007-003","LEGACY-GAP-007-005"],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
