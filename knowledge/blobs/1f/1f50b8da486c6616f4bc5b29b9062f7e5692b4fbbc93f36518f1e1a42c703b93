{"candidate_id":"MM-019-013","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":19,"lecture_title":"урок 17","topic":"mirror_level","scenario":"left_history_and_right_confirmation","claim_type":"principle","tags":["levels","market_selection","saw"],"primary_tag":"levels","statement":"Зеркальный уровень подтверждается тем, что цена реагировала на одну и ту же область с разных сторон, поэтому смотреть надо и историю слева, и текущие реакции справа.","quote":"видим здесь зеркальный уровень... Он стал потом зеркальный. Еще одно подтверждение... Потом начали его пилить. И еще одно подтверждение","interpretation":"Зеркальность усиливает уровень, но не отменяет необходимости оценить, не начал ли уровень пилиться.","confidence":0.9,"maturity":"observed_multimodal","source_time":"00:26:57-00:28:07","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_019_52874787","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_019_urok_17/claims_multimodal.jsonl","source_units":["lec_019_52874787_seg_0053","lec_019_52874787_seg_0054","lec_019_52874787_seg_0055"],"source_frames":[{"path":"урок 17/frames/frame_00077.jpg","time":"00:27:17"},{"path":"урок 17/frames/frame_00078.jpg","time":"00:27:46"}],"source_unit_count":3,"source_frame_count":2,"quote_source_overlap":1.0},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
