{"candidate_id":"MM-008-028","candidate_kind":"observed_multimodal_claim","status":"canonical_candidate_pool_member","review_status":"needs_later_source","course_position":8,"lecture_title":"урок 07","topic":"risk_reward","scenario":"four_stop_room_example","claim_type":"example","tags":["atr_room","entry","levels","risk","stop"],"primary_tag":"atr_room","statement":"SUI-пример показывает, что если от локального уровня внутри канала есть около 4 стопов до верхней границы, то такая сделка из середины канала может быть допустима; если расстояния меньше, вход не подходит по математике.","quote":"Визуально это видно, что здесь мы можем забрать... есть расстояние 4 к 1... из середины канала... можем зайти при наличии запаса хода 4 стопа.","interpretation":"This is the concrete visual example for applying the 4-stop room rule.","confidence":0.84,"maturity":"observed_multimodal","source_time":"01:44:28-01:49:50","source_trace":{"source_kind":"observed_multimodal_claim","lecture_id":"lec_008_7252f831","source_file":"_knowledge_base/structured/lecture_pass/lectures/lecture_008_urok_07/claims_multimodal.jsonl","source_units":["lec_008_7252f831_seg_0229","lec_008_7252f831_seg_0230","lec_008_7252f831_seg_0231","lec_008_7252f831_seg_0232","lec_008_7252f831_seg_0233","lec_008_7252f831_seg_0234","lec_008_7252f831_seg_0235","lec_008_7252f831_seg_0236","lec_008_7252f831_seg_0237","lec_008_7252f831_seg_0238"],"source_frames":[{"path":"урок 07/frames/frame_00142.jpg","time":"01:45:02"},{"path":"урок 07/frames/frame_00145.jpg","time":"01:46:50"},{"path":"урок 07/frames/frame_00147.jpg","time":"01:48:50"},{"path":"урок 07/frames/frame_00148.jpg","time":"01:49:50"}],"source_unit_count":10,"source_frame_count":4,"quote_source_overlap":1.0},"support_annotation_count":0,"support_gap_ids":[],"candidate_pool_version":"canonical_candidate_pool_v1","execution_allowed":false,"canonical_rulebook_allowed":false}
