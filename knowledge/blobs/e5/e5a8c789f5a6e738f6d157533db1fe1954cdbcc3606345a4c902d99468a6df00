{"unit_id": "lec_017_7afa69d7_seg_0202", "artifact_type": "multimodal_evidence_unit", "course_position": 17, "lecture_title": "урок 15", "lecture_id": "lec_017_7afa69d7", "segment_index": 202, "start_sec": 5778.67, "end_sec": 5809.37, "time": "01:36:19-01:36:49", "text": "то это значит, что 5 центов это нормальный стоп-лосс для этой акции. Это значит, что максимум, что мы можем себе позволить, это 9.95 поставить стоп-лосс. Может быть, мы можем обойтись меньшим стопом, но нормальный стоп-лосс, то есть это будет не большой, не очень маленький, а нормальный размер стопа в пределах 5 центов. То есть размер стопа будет 0.05.", "frames": [{"time_sec": 5805.75, "time": "01:36:46", "path": "урок 15/frames/frame_00149.jpg", "trigger": "scene", "scene_index": 104, "linked_segment_index": 202, "ocr_text": "10\n9.95$\n0 5 нтR", "ocr_line_count": 3, "ocr_repair_version": "ocr_unicode_path_repair_v1"}], "frame_count": 1, "ocr_frame_count": 1, "ocr_chars": 16}
